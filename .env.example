# Google Maps API key (Geocoding API + Distance Matrix API enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to choose which LLM to use for place and keyword discovery.
# Supported values: "groq" (default) | "gemini"
LLM_PROVIDER=groq

# ── Groq (default) ───────────────────────────────────────────────────────────
# Required if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model (default: qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required if LLM_PROVIDER=gemini
# Get your key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
